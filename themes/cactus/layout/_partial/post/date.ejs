<% if (post.date) { %>
    <div class="<%= class_name %>">
      <% if (is_post()) { %>
        <time datetime="<%= date_xml(post.date) %>" class="dt-published"><%= date(post.date, config.date_format) %></time>
        <%# Same-day edits are not worth a second date; readers care about real revisions. %>
        <% if (theme.post.show_updated && post.updated && date(post.updated, config.date_format) !== date(post.date, config.date_format)) { %>
        (<%= __('post.updated') %>: <time datetime="<%= date_xml(post.updated) %>" class="dt-updated"><%= date(post.updated, config.date_format) %></time>)
        <% } %>
      <% } else { %>
        <% if (is_home() && theme.posts_overview.sort_updated || is_archive() && theme.archive.sort_updated ) { %>
          <time datetime="<%= date_xml(post.updated) %>" class="dt-updated"><%= date(post.updated, config.date_format) %></time>
        <% } else { %>
          <time datetime="<%= date_xml(post.date) %>" class="dt-published"><%= date(post.date, config.date_format) %></time>
        <% } %>
      <% } %>
    </div>
<% } %>
